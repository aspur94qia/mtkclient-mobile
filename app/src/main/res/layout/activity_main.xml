<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MTK Client Mobile (Engine v1.1)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">
        
        <Button
            android:id="@+id/btn_scan_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="1. SCAN OTG"
            android:backgroundTint="#00796B"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_send_bypass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="2. HANDSHAKE"
            android:backgroundTint="#0288D1"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:weightSum="2">
        
        <Button
            android:id="@+id/btn_read_hw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="READ HW INFO"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_bypass_sla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="DISABLE AUTH (SLA)"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/tv_console_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Console Log Ready...\n"
            android:textColor="#00FF00"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
